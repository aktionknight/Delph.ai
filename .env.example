# Copy to .env at repository root. Never commit credentials.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# Text model order: lowest latency first, stronger models afterward.
GEMINI_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.5-flash
# Optional role overrides: STRATEGIST, MARKETING, CREATIVE, EVALUATOR, ANALYTICS.
# GEMINI_MARKETING_MODEL=gemini-3.1-flash-lite
# GEMINI_MARKETING_FALLBACK_MODELS=gemini-3.5-flash-lite,gemini-3.8-flash,gemini-3.5-flash
AI_FALLBACK_ENABLED=true
AI_PROVIDER_FALLBACK_ENABLED=true
AI_MODEL_TIMEOUT_SECONDS=45
AI_REQUEST_TIMEOUT_SECONDS=150
AI_MAX_MODEL_ATTEMPTS=7
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Optional Gemini speech model; leave blank to use Edge TTS.
GEMINI_TTS_MODEL=
GEMINI_TTS_VOICE=Kore
# Optional text failover when Gemini models are exhausted.
GROQ_API_KEY=
GROQ_CONTENT_MODEL=openai/gpt-oss-20b
GROQ_EVALUATOR_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b
# GROQ_MARKETING_MODEL=openai/gpt-oss-20b
# GROQ_MARKETING_FALLBACK_MODELS=openai/gpt-oss-120b
# All five agent roles default to Gemini, then Groq if its key is present.
# Set any <ROLE>_PROVIDER=groq to reverse the provider order for that role.
CREATIVE_PROVIDER=gemini
EVALUATOR_PROVIDER=gemini
# Legacy WRITER_PROVIDER/REPAIR_PROVIDER still work if CREATIVE_PROVIDER is unset.
COHERE_API_KEY=
COHERE_RERANK_MODEL=rerank-v3.5
# Images use Pollinations only. Store this secret in the backend environment, never the frontend.
POLLINATIONS_API_KEY=
POLLINATIONS_IMAGE_MODEL=flux
TTS_PROVIDER=edge
EDGE_TTS_VOICE=en-US-JennyNeural
OBJECT_STORAGE=mongo
R2_ENDPOINT=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
MONGODB_URI=
MONGODB_DATABASE=campaign_launchpad
DEMO_MODE=false
# false only for local HTTP development. Use true behind HTTPS in deployment.
COOKIE_SECURE=false
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://127.0.0.1:8000
# Set BACKEND_URL on VERCEL to the Render origin (no /api suffix).
# Existing Vercel NEXT_PUBLIC_API_URL is a compatible fallback; no public variable is required.
# Production deployment aliases (also accepted by the proxy/origin allowlist)
FRONTEND_URL_PRODUCTION=
BACKEND_URL_PRODUCTION=
# CORS allowed origins (comma-separated; paste your Vercel and Render URLs)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:8000
# Social OAuth: server-only developer app credentials. Callback URLs must match app settings.
OAUTH_TOKEN_ENCRYPTION_KEY=
X_CLIENT_ID=
X_CLIENT_SECRET=
X_REDIRECT_URI=http://localhost:3000/api/connect/x/callback
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:3000/api/connect/linkedin/callback
LINKEDIN_API_VERSION=202609
# Enable only after LinkedIn approves r_member_postAnalytics for your app, then reconnect.
LINKEDIN_ANALYTICS_ENABLED=false
# Dev launcher starts the durable publishing worker when enabled.
SOCIAL_WORKER_ENABLED=false
SOCIAL_AUTO_INSIGHTS=true
